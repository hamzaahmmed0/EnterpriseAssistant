# Copy to .env and fill in. Never commit .env.
# Every variable here has a matching field in backend/app/config.py.
# Values shown are the decided defaults from docs/DECISIONS.md; secrets are blank.

# ---------------------------------------------------------------- app
APP_ENV=local                       # local | docker | cloud
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- auth (demo)
AUTH_SECRET=                        # REQUIRED. HMAC signing key: openssl rand -hex 32
AUTH_TOKEN_TTL_MINUTES=480          # ADR-006
DEMO_USERS_PATH=backend/demo_users.json

# ---------------------------------------------------------------- postgres
DATABASE_URL=postgresql+psycopg://eka:eka@localhost:5432/eka
POSTGRES_DB=eka                     # used by docker-compose only
POSTGRES_USER=eka                   # used by docker-compose only
POSTGRES_PASSWORD=eka               # used by docker-compose only

# ---------------------------------------------------------------- qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                     # empty for local docker
QDRANT_DOCUMENTS_COLLECTION=documents_collection
QDRANT_POLICY_COLLECTION=policy_collection

# ---------------------------------------------------------------- embeddings (ADR-005)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=1536                  # text-embedding-3-small; 768 for nomic-embed-text
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------- llm (ADR-005)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.0                 # keep at 0 so eval runs are replayable
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- ingestion (ADR-003, sweepable)
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
INGEST_SOURCE_DIR=data/corpus
INGEST_MANIFEST_PATH=data/corpus/manifest.json

# ---------------------------------------------------------------- retrieval (ADR-004, ADR-012, sweepable)
RETRIEVAL_TOP_K=5                   # chunks placed in the LLM context
EVAL_REPORT_K=5                     # k for precision@k / recall@k; separate on purpose
RETRIEVAL_SCORE_FLOOR=              # optional per-chunk similarity floor; blank disables
EVIDENCE_THRESHOLD=0.6              # judge sufficiency cutoff; calibrated in Sprint 2
EVIDENCE_MODE=similarity          # judge (LLM, ADR-004) | similarity (retrieval score, reliable on local)
ADAPTIVE_MAX_ATTEMPTS=3             # hard cap, 2-3
RETRIEVAL_MODE=adaptive             # fixed | hybrid_rerank | adaptive -- the three eval configs
RERANKER_MODEL=                     # only for hybrid_rerank; still an open question
JUDGE_CACHE_PATH=eval/results/.judge_cache.json   # replay judge verdicts across re-runs

# ---------------------------------------------------------------- contract review
CONTRACT_MAX_UPLOAD_MB=10
CONTRACT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
CONTRACT_TOP_K=5
CONTRACT_UPLOAD_DIR=data/contracts
SEGMENTATION_MAX_CLAUSE_CHARS=4000  # ADR-009 fallback trigger

# ---------------------------------------------------------------- mcp
MCP_TRANSPORT=stdio                 # stdio | http
MCP_HTTP_PORT=8001                  # only when MCP_TRANSPORT=http

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_APP_NAME=Enterprise Knowledge Assistant
BACKEND_INTERNAL_URL=http://localhost:8000   # server-side only; never NEXT_PUBLIC_

# ---------------------------------------------------------------- providers (deployment switch)
LLM_PROVIDER=ollama                 # ollama (local, ADR-005 eval stack) | openai (deployment)
EMBEDDING_PROVIDER=ollama           # ollama | openai -- switching changes EMBEDDING_DIM, re-ingest
OPENAI_API_KEY=                     # REQUIRED when either provider is openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # 1536-dim
