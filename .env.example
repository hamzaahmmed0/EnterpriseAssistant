# Copy to .env and fill in. Never commit .env.
# Every variable below must have a matching entry in backend/app/config.py.

# ---------------------------------------------------------------- app
APP_ENV=                  # local | docker | cloud
LOG_LEVEL=                # DEBUG | INFO | WARNING
API_HOST=                 # bind address for FastAPI (e.g. 0.0.0.0)
API_PORT=                 # port for FastAPI (e.g. 8000)
CORS_ALLOWED_ORIGINS=     # comma-separated; frontend origin(s)

# ---------------------------------------------------------------- auth (demo)
AUTH_SECRET=              # signing secret for demo session tokens
AUTH_TOKEN_TTL_MINUTES=   # session lifetime; TODO decide (see DECISIONS ADR-006)
DEMO_USERS_PATH=          # path to the JSON file defining the 3-4 demo users

# ---------------------------------------------------------------- postgres
POSTGRES_HOST=
POSTGRES_PORT=            # 5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=             # optional single-DSN override of the six vars above

# ---------------------------------------------------------------- qdrant
QDRANT_HOST=
QDRANT_PORT=              # 6333 (HTTP) / 6334 (gRPC)
QDRANT_API_KEY=           # empty for local docker
QDRANT_DOCUMENTS_COLLECTION=   # e.g. documents_collection
QDRANT_POLICY_COLLECTION=      # e.g. policy_collection

# ---------------------------------------------------------------- embeddings
EMBEDDING_MODEL=          # BAAI/bge-small-en-v1.5 | nomic-embed-text  (ADR-005: undecided)
EMBEDDING_DIM=            # must match EMBEDDING_MODEL; asserted at collection creation
EMBEDDING_BATCH_SIZE=

# ---------------------------------------------------------------- llm (ollama)
OLLAMA_BASE_URL=          # e.g. http://localhost:11434
LLM_MODEL=                # qwen2.5:7b-instruct or similar; TODO pin exact tag (ADR-005)
LLM_TEMPERATURE=          # generation must be near-deterministic for eval reproducibility
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------- ingestion (sweepable)
CHUNK_SIZE_TOKENS=        # TODO open question, ADR-003
CHUNK_OVERLAP_TOKENS=     # TODO open question, ADR-003
INGEST_SOURCE_DIR=        # e.g. data/corpus

# ---------------------------------------------------------------- retrieval (sweepable)
RETRIEVAL_TOP_K=          # k for precision@k / recall@k reporting; eval reports @5
RETRIEVAL_SCORE_FLOOR=    # per-chunk similarity floor, if used
EVIDENCE_THRESHOLD=       # adaptive-loop trigger; calibrated in Week 2 (ADR-004)
ADAPTIVE_MAX_ATTEMPTS=    # hard cap, 2-3 (ADR-004)
RETRIEVAL_MODE=           # fixed | hybrid_rerank | adaptive  -- the three eval configs
RERANKER_MODEL=           # only used when RETRIEVAL_MODE=hybrid_rerank; TODO choose

# ---------------------------------------------------------------- contract review
CONTRACT_MAX_UPLOAD_MB=
CONTRACT_ALLOWED_MIME_TYPES=   # comma-separated (pdf, docx)
CONTRACT_TOP_K=                # per-clause policy retrieval depth

# ---------------------------------------------------------------- mcp
MCP_TRANSPORT=            # stdio | http
MCP_HTTP_PORT=            # only when MCP_TRANSPORT=http

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_APP_NAME=
BACKEND_INTERNAL_URL=     # server-side only; the browser must never call the backend directly
