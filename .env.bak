# Copy to .env and fill in. Never commit .env.
# Every variable here has a matching field in backend/app/config.py.
# Values shown are the decided defaults from docs/DECISIONS.md; secrets are blank.

# ---------------------------------------------------------------- app
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- auth (demo)
AUTH_SECRET=f998a0f42b39abab56e643afcbf201bd6ed2b3bb590534c7cbbd141176d72273
AUTH_TOKEN_TTL_MINUTES=480
DEMO_USERS_PATH=backend/demo_users.json

# ---------------------------------------------------------------- postgres
DATABASE_URL=postgresql+psycopg://eka:eka@localhost:5432/eka
POSTGRES_DB=eka
POSTGRES_USER=eka
POSTGRES_PASSWORD=eka

# ---------------------------------------------------------------- qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_DOCUMENTS_COLLECTION=documents_collection
QDRANT_POLICY_COLLECTION=policy_collection

# ---------------------------------------------------------------- embeddings (ADR-005)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------- llm (ADR-005)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- ingestion (ADR-003, sweepable)
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
INGEST_SOURCE_DIR=data/corpus
INGEST_MANIFEST_PATH=data/corpus/manifest.json

# ---------------------------------------------------------------- retrieval (ADR-004, ADR-012, sweepable)
RETRIEVAL_TOP_K=5
EVAL_REPORT_K=5
RETRIEVAL_SCORE_FLOOR=
EVIDENCE_THRESHOLD=0.6
ADAPTIVE_MAX_ATTEMPTS=3
RETRIEVAL_MODE=adaptive
RERANKER_MODEL=
JUDGE_CACHE_PATH=eval/results/.judge_cache.json

# ---------------------------------------------------------------- contract review
CONTRACT_MAX_UPLOAD_MB=10
CONTRACT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
CONTRACT_TOP_K=5
CONTRACT_UPLOAD_DIR=data/contracts
SEGMENTATION_MAX_CLAUSE_CHARS=4000

# ---------------------------------------------------------------- mcp
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8001

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_APP_NAME=Enterprise Knowledge Assistant
BACKEND_INTERNAL_URL=http://localhost:8000
